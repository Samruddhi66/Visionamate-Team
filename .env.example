# VisionMate 2.0 — Environment Configuration Example
# Copy this file to .env and configure your environment variables.
# NEVER commit production API keys or credentials to source control.

# Application Environment (development, staging, production)
VISIONMATE_ENV=development

# Remote Vision-Language Model API (Optional, if using cloud-backed scene analysis)
# If empty, VisionMate uses on-device inference by default.
VISION_API_BASE_URL=https://api.visionmate.local/v1
VISION_API_KEY=your_api_key_here
VISION_REQUEST_TIMEOUT_MS=15000

# Mapping & Routing Provider (OSRM is default and requires no key)
# OSRM public foot router: http://router.project-osrm.org/route/v1/foot
ROUTING_SERVICE_URL=http://router.project-osrm.org/route/v1/foot
MAPS_GEOCODING_API_KEY=

# Emergency SMS Gateway (Optional custom webhook fallback)
EMERGENCY_SMS_GATEWAY_URL=

# Offline On-Device Model Asset Paths
ON_DEVICE_INR_MODEL_PATH=assets/models/inr_classifier.tflite
ON_DEVICE_OBJECT_MODEL_PATH=assets/models/ssd_mobilenet_v2.tflite
